# 文字决策与回答：推荐 DeepSeek 非推理聊天模型。不要提交实际密钥。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=2048

# 以下星火配置仅在 LLM_PROVIDER=spark 时使用；无需为 DeepSeek 填写。
# 讯飞星火大模型（OpenAI 兼容接口）配置
# 在讯飞开放平台控制台 -> 对应应用 里获取「APIPassword」，
# 注意不是 WebSocket 接口的 APIKey/APISecret。
SPARK_API_PASSWORD=

# 以下为可选配置，均有默认值，按需修改。
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1
SPARK_MODEL=generalv3.5
SPARK_TEMPERATURE=0.3
SPARK_MAX_TOKENS=2048

# 图片理解：DeepSeek-VL2-Small 为视觉问答模型，需要另行部署/购买兼容图片的推理服务。
# 这里不能填写普通 api.deepseek.com，官方文字 API Key 不等于视觉服务授权。
VISION_PROVIDER=deepseek
DEEPSEEK_VISION_BASE_URL=
DEEPSEEK_VISION_API_KEY=
DEEPSEEK_VISION_MODEL=deepseek-ai/deepseek-vl2-small

# 旧讯飞图片接口仅在 VISION_PROVIDER=xfyun 时使用（不会作为 DeepSeek 失败回退）。
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
# 图片只提取关键观察，减少生成等待；需要更长标签转录时可调高（200至2028）。
VISION_MAX_TOKENS=800

# 系统提示词（可选）
# SYSTEM_PROMPT=

# 天气数据源：高德天气 Web 服务 key。留空或失败时明确不可用，不回退模拟数据。
WEATHER_API_KEY=

# Agent 编排循环最多调用几轮工具
MAX_TOOL_ITERATIONS=4

# 留空默认使用内置20条官方公告记录（当前状态仍待核实）。
# 可填写审校后的登记快照绝对路径覆盖；路径错误会明确失败，不回退到旧结果。
# 结构及审校要求见 docs/pesticide-data.md。不会用演示数据回退。
PESTICIDE_CATALOG_PATH=
